# ============ FinSightPro 环境变量配置 ============
# 复制本文件为 .env 并填入你自己的配置。.env 已被 .gitignore 排除，不会进入仓库。

# ---------- Flask ----------
# 会话密钥：请改为任意长随机字符串（如 python -c "import secrets;print(secrets.token_hex(32))"）
SECRET_KEY=please-change-me-to-a-random-string
# 服务端口（也可用 run.py --port 覆盖）
PORT=5231

# ---------- LLM 配置（OpenAI 兼容协议） ----------
# 支持任意 OpenAI 兼容服务商：DeepSeek / 通义千问 / 智谱 GLM / Kimi / 本地 vLLM 等
# 示例（DeepSeek）：LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
# 必填：你的模型 API Key
LLM_API_KEY=
# 可选：备用 Key（主 Key 401 时自动切换）
LLM_API_KEY_FALLBACK=
# 默认模型名（按服务商填写，如 deepseek-v3 / qwen-plus / glm-4-plus）
LLM_MODEL=deepseek-v3
# 可选：辩论引擎三个角色分别使用的模型（留空则使用 LLM_MODEL）
# 建议给生成器 A/B 配置不同模型以获得更真实的"辩论"效果
GENERATOR_A_MODEL=
GENERATOR_B_MODEL=
JUDGE_MODEL=

# ---------- 数据抓取 ----------
# 行情数据缓存有效期（分钟）
CACHE_TTL_MINUTES=30

# ---------- 辩论引擎 ----------
# 辩论模式：adversarial = 多空对抗（推荐，A 看多 vs B 看空，Judge 中立仲裁）
#           parallel    = 平行视角（A 偏财务估值 vs B 偏行业风险）
DEBATE_MODE=adversarial
# 真流式输出（OpenAI stream=true 逐 token 推送；服务商不支持时自动回退）
LLM_STREAM=true

# ---------- 可选：RAG / MetaGPT 插件引擎（默认不启用） ----------
# 如需启用旧版多智能体 RAG 引擎，请填写以下配置并安装可选依赖
ZHIPUAI_API_KEY=
BOCHA_API_KEY=
DASHSCOPE_API_KEY=
VLLM_API_BASE=http://127.0.0.1:8731/v1
VLLM_API_KEY=
VLLM_MODEL=Qwen/Qwen3-14B
